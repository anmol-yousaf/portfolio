<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Anmol Yousaf — Full-Stack & DevOps Engineer</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Full-stack developer and DevOps engineer — Ruby on Rails, AWS, 9 years shipping and running production systems.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">

    <%= yield :head %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-ink text-paper antialiased">
    <%= yield %>
  </body>
</html>
