<div class="lg:flex lg:min-h-screen max-w-[1440px] mx-auto" data-controller="scroll-spy">

  <!-- Sidebar -->
  <aside class="min-h-[100dvh] lg:sticky lg:top-0 lg:h-screen lg:w-[380px] lg:shrink-0 px-8 py-16 lg:py-24 flex flex-col justify-between">
    <div>
      <h1 class="font-display text-3xl font-bold text-paper">Anmol Yousaf</h1>
      <p class="font-mono text-sm text-amber-soft mt-2">Full-Stack &amp; DevOps Engineer</p>
      <p class="text-paper-dim mt-4 leading-relaxed max-w-xs">
        I don't just build, I own what happens after.
      </p>

      <a href="/resume.pdf"
         download="Anmol_Yousaf_Resume.pdf"
         class="fab-resume group fixed bottom-8 right-8 z-50 flex items-center gap-2 pl-3.5 pr-5 py-3 rounded-full bg-ink border border-amber text-amber-soft font-mono text-sm font-medium shadow-[0_8px_24px_-4px_rgba(201,122,61,0.35)] hover:shadow-[0_8px_32px_-4px_rgba(201,122,61,0.55)] hover:scale-105 transition-all duration-300">

        <span class="fab-ring absolute inset-0 rounded-full bg-amber opacity-40 -z-10"></span>

        <svg class="w-4 h-4 shrink-0 text-amber group-hover:translate-y-0.5 transition-transform" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M10 3v9" stroke-linecap="round"/>
          <path d="m6 8 4 4 4-4" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M4 15v1a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-1" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>

        <span>Resume</span>
      </a>

      <nav class="mt-12 hidden lg:block" aria-label="Section navigation">
        <ul class="space-y-4 font-mono text-sm">
          <li><a href="#about" data-scroll-spy-target="link" class="text-paper-dim hover:text-amber transition-colors">about</a></li>
          <li><a href="#experience" data-scroll-spy-target="link" class="text-paper-dim hover:text-amber transition-colors">experience</a></li>
          <li><a href="#projects" data-scroll-spy-target="link" class="text-paper-dim hover:text-amber transition-colors">projects</a></li>
          <li><a href="#currently" data-scroll-spy-target="link" class="text-paper-dim hover:text-amber transition-colors">currently</a></li>
          <li><a href="#contact" data-scroll-spy-target="link" class="text-paper-dim hover:text-amber transition-colors">contact</a></li>
        </ul>
      </nav>
    </div>

    <!-- Social icons -->
    <div class="flex gap-4 mt-12 lg:mt-0 pb-2">
      <a href="https://github.com/anmol-yousaf"
         class="flex items-center justify-center w-11 h-11 rounded-lg border border-slate/30 bg-ink-soft text-paper-dim hover:text-amber hover:border-amber/50 hover:bg-ink transition-colors"
         aria-label="GitHub" target="_blank" rel="noopener">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 2.87-.39c.97 0 1.95.13 2.87.39 2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.73.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.39-5.25 5.67.42.36.78 1.08.78 2.17 0 1.57-.01 2.83-.01 3.22 0 .3.21.66.79.55A10.99 10.99 0 0 0 23.5 12c0-6.35-5.15-11.5-11.5-11.5Z"/>
        </svg>
      </a>

      <a href="https://linkedin.com/in/anmol-yousaf"
         class="flex items-center justify-center w-11 h-11 rounded-lg border border-slate/30 bg-ink-soft text-paper-dim hover:text-amber hover:border-amber/50 hover:bg-ink transition-colors"
         aria-label="LinkedIn" target="_blank" rel="noopener">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
          <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z"/>
        </svg>
      </a>

      <a href="mailto:contact@anmolyousaf.com"
         class="flex items-center justify-center w-11 h-11 rounded-lg border border-slate/30 bg-ink-soft text-paper-dim hover:text-amber hover:border-amber/50 hover:bg-ink transition-colors"
         aria-label="Email">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="20" height="20">
          <path d="M3 5.5h18v13H3v-13Z" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="m3 6 9 7 9-7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </aside>

  <!-- Content -->
  <main class="flex-1 px-8 py-16 lg:py-24 lg:px-16 max-w-3xl xl:max-w-4xl">

    <!-- Hero -->
    <section class="mb-24 scroll-mt-16 reveal" data-scroll-spy-target="reveal">
      <p class="font-mono text-amber text-sm mb-4">$ whoami</p>
      <h2 class="font-display text-2xl lg:text-3xl font-bold leading-snug text-paper">
        8+ years of experience shipping and running production systems in Ruby on Rails, Laravel, Elixir and AWS.
      </h2>
      <p>Remote, Annetech LLC | USA.</p>
    </section>

    <!-- Signature: deploy log strip -->
    <section class="mb-24 border border-slate/30 rounded-md bg-ink-soft font-mono text-sm overflow-hidden reveal" data-scroll-spy-target="reveal" aria-label="Career highlights, shown as a deploy log">
      <div class="px-5 py-3 border-b border-slate/30 text-paper-dim text-xs">career.log</div>
      <div class="px-5 py-4 space-y-2 text-paper-dim">
        <p><span class="text-amber">$</span> led team of 10+ engineers @ EZO, architected private cloud infra for enterprise clients</p>
        <p><span class="text-amber">$</span> reduced production downtime 20% via process changes @ Wego Health</p>
        <p><span class="text-amber">$</span> sole developer &amp; infra owner, launched Wild West RV Supplies</p>
        <p><span class="text-amber">$</span> operating US LLC, contracting for clients across US/UK since 2022</p>
      </div>
    </section>

    <!-- About -->
    <section id="about" class="mb-24 scroll-mt-16 reveal" data-scroll-spy-target="reveal">
      <h3 class="font-mono text-amber text-sm mb-6">01 — about</h3>
      <p class="text-paper-dim leading-relaxed">
        I'm a full-stack developer and DevOps engineer with 8+ years of experience across Ruby on Rails, Laravel, and AWS. I own a US-based LLC providing contract development and infrastructure services to clients in the US and UK from providing full-stack development help, manage technical team to architecting CI/CD pipelines. Expert at integrating third-party services and streamlining operations for enhanced efficiency. Working remotely with async-friendly overlap hours.
      </p>
    </section>

    <!-- Experience -->
    <section id="experience" class="mb-24 scroll-mt-16">
      <h3 class="font-mono text-amber text-sm mb-6">02 — experience</h3>
      <div class="space-y-6">
        <% @experience.each do |job| %>
          <div class="group relative border-l-2 border-slate/30 pl-6 py-4 rounded-r-md hover:border-amber hover:bg-white/[0.03] hover:backdrop-blur-sm transition-all">
            <% if job[:url].present? %>
              <a href="<%= job[:url] %>" target="_blank" rel="noopener" class="absolute inset-0 z-0" aria-label="<%= job[:role] %> at <%= job[:org] %>"></a>
            <% end %>

            <div class="relative z-10 pointer-events-none">
              <div class="flex flex-wrap items-baseline gap-x-3">
                <h4 class="font-display font-bold text-paper group-hover:text-amber-soft transition-colors"><%= job[:role] %></h4>
                <span class="text-paper-dim">·</span>
                <span class="text-paper-dim"><%= job[:org] %></span>
              </div>
              <p class="font-mono text-xs text-slate mt-1"><%= job[:period] %></p>
              <p class="font-mono text-xs text-amber-soft mt-3"><%= job[:log] %></p>
              <ul class="mt-3 space-y-1.5 text-paper-dim text-sm leading-relaxed">
                <% job[:notes].each do |note| %>
                  <li>— <%= note %></li>
                <% end %>
              </ul>
            </div>
          </div>

          <!-- Nested sub-roles -->
          <% if job[:sub_roles].present? %>
            <div class="ml-6 space-y-4">
              <% job[:sub_roles].each do |sub| %>
                <div class="group relative border-l-2 border-slate/20 pl-6 py-3 rounded-r-md hover:border-amber hover:bg-white/[0.03] hover:backdrop-blur-sm transition-all">
                  <% if sub[:url].present? %>
                    <a href="<%= sub[:url] %>" target="_blank" rel="noopener" class="absolute inset-0 z-0" aria-label="<%= sub[:role] %> at <%= sub[:org] %>"></a>
                  <% end %>

                  <div class="relative z-10 pointer-events-none">
                    <div class="flex flex-wrap items-baseline gap-x-3">
                      <h5 class="font-display font-semibold text-paper text-sm group-hover:text-amber-soft transition-colors"><%= sub[:role] %></h5>
                      <span class="text-paper-dim text-sm">·</span>
                      <span class="text-paper-dim text-sm"><%= sub[:org] %></span>
                    </div>
                    <p class="font-mono text-xs text-slate mt-1"><%= sub[:period] %></p>
                    <p class="font-mono text-xs text-amber-soft mt-2"><%= sub[:log] %></p>
                    <ul class="mt-2 space-y-1 text-paper-dim text-xs leading-relaxed">
                      <% sub[:notes].each do |note| %>
                        <li>— <%= note %></li>
                      <% end %>
                    </ul>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    </section>

    <!-- Projects -->
    <section id="projects" class="mb-24 scroll-mt-16 reveal" data-scroll-spy-target="reveal">
      <h3 class="font-mono text-amber text-sm mb-6">03 — projects</h3>
      <div class="space-y-8">
        <% @projects.each do |project| %>
          <% link = project.url.presence || project.github_url %>
          <div class="group glass-card relative border border-slate/30 rounded-md p-6 bg-ink-soft hover:border-amber/50 hover:bg-white/[0.03] hover:backdrop-blur-md hover:shadow-[0_0_20px_-4px_rgba(201,122,61,0.25)] hover:-translate-y-1 transition-all duration-300">
            <% if link.present? %>
              <a href="<%= link %>" target="_blank" rel="noopener" class="absolute inset-0 z-20" aria-label="<%= project.title %>"></a>
            <% end %>

            <div class="relative z-10 pointer-events-none">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h4 class="font-display font-bold text-paper text-lg group-hover:text-amber-soft transition-colors"><%= project.title %></h4>
                <% if project.url.present? %>
                  <span class="font-mono text-xs text-amber">view →</span>
                <% end %>
              </div>
              <p class="text-paper-dim text-sm leading-relaxed mt-3"><%= project.description %></p>
              <% if project.tech_stack.present? %>
                <p class="font-mono text-xs text-slate mt-4"><%= project.tech_stack %></p>
              <% end %>
              <% if project.github_url.present? %>
                <a href="<%= project.github_url %>" target="_blank" rel="noopener"
                   class="relative z-30 pointer-events-auto font-mono text-xs text-paper-dim hover:text-amber transition-colors mt-2 inline-block">
                  source →
                </a>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </section>

    <!-- Currently -->
    <section id="currently" class="mb-24 scroll-mt-16 reveal" data-scroll-spy-target="reveal">
      <h3 class="font-mono text-amber text-sm mb-6">04 — currently</h3>

      <div class="relative border border-slate/30 rounded-md bg-ink-soft overflow-hidden">
        <!-- Scanning line -->
        <div class="absolute top-0 left-0 h-[2px] w-full overflow-hidden">
          <div class="h-full w-1/3 bg-gradient-to-r from-transparent via-amber to-transparent animate-scan"></div>
        </div>

        <!-- Ticker header bar -->
        <div class="flex items-center gap-2.5 px-6 py-4 border-b border-slate/30 bg-ink/40">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full rounded-full bg-amber animate-blink"></span>
          </span>
          <span class="font-mono text-xs text-amber tracking-widest uppercase">Live</span>
          <span class="font-mono text-xs text-paper-dim ml-auto">Aug 2026</span>
        </div>

        <!-- Headline entry -->
        <div class="px-6 py-6">
          <p class="font-mono text-xs text-paper-dim mb-3">$ status --track=certification</p>
          <p class="text-paper leading-relaxed">
            Working through the <span class="text-amber-soft">AWS Certified Solutions Architect, Associate (SAA-C03)</span>
            certification.
          </p>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="mb-32 scroll-mt-16 reveal" data-scroll-spy-target="reveal">
      <h3 class="font-mono text-amber text-sm mb-6">05 — contact</h3>
      <p class="text-paper-dim leading-relaxed mb-4">
        Open to new Rails and Laravel contract work. The fastest way to reach me:
      </p>
      <a href="mailto:contact@anmolyousaf.com" class="font-mono text-amber hover:text-amber-soft transition-colors text-lg">
        contact@anmolyousaf.com
      </a>
    </section>

  </main>
</div>
